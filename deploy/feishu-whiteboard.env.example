# 复制为 /etc/feishu-whiteboard.env

HOME=/root

# 独立 whiteboard service
FEISHU_WHITEBOARD_PORT=8088
FEISHU_WHITEBOARD_HOST=0.0.0.0
FEISHU_WHITEBOARD_SERVICE_BASE_URL=http://127.0.0.1:8088

# 飞书开放平台应用
FEISHU_APP_ID=
# 二选一：建议用 secret 文件
FEISHU_APP_SECRET_FILE=/etc/feishu-ws-cursor-bot.secret
# FEISHU_APP_SECRET=
FEISHU_LARK_DOMAIN=lark

# 白板相关
FEISHU_WHITEBOARD_DEFAULT_ID=S5yWwgo0dhkrCIb1qNZlBvs3gwg
FEISHU_WHITEBOARD_REDIRECT_URI=http://43.133.44.67:8088/feishu/oauth/callback
FEISHU_WHITEBOARD_OAUTH_SCOPE="board:whiteboard:node:create offline_access"
FEISHU_WHITEBOARD_TOKEN_STORE=/etc/feishu-whiteboard-bot.token.json

# 可选：保护 replay API，若留空则仅靠主机网络边界保护
FEISHU_WHITEBOARD_SERVICE_TOKEN=

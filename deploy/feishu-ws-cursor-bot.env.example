# 复制到 /etc/feishu-ws-cursor-bot.env 并按环境修改。
#
# =========================
# 核心启动块（最小可启动）
# =========================
# 飞书租户：feishu | lark
# FEISHU_LARK_DOMAIN=feishu
#
# 飞书触发模式：direct | prefix
# FEISHU_CURSOR_TRIGGER_ENABLED=1
# FEISHU_CURSOR_MODE=direct
#
# prefix 模式下建议设置，例如 /code
# FEISHU_CURSOR_TRIGGER_PREFIX=/code
#
# 前缀模式下，用户未带前缀时是否回复一行说明（默认 1；群聊怕刷屏可设 0）
# FEISHU_PREFIX_MISS_HINT=1
#
# direct 模式下强烈建议设置允许会话白名单（逗号分隔 chat_id）
# FEISHU_CURSOR_ALLOWED_CHAT_IDS=
#
# OpenClaw Gateway（必填；飞书消息经 openclaw gateway call 转发）
# OPENCLAW_GATEWAY_URL=ws://10.0.0.12:31721
# OPENCLAW_GATEWAY_TOKEN=与网关 gateway.auth.token 一致（若启用）
# OPENCLAW_BIN=/root/.nvm/versions/node/v22.22.1/bin/openclaw
#
# Gateway-first 分流：桥侧只选择逻辑 agent id，实际模型/runtime 由 OpenClaw Gateway 的 agents.list 决定。
# 默认重任务 -> cursor，轻任务 -> main；如网关使用不同 agent id，可在此覆盖：
# OPENCLAW_HEAVY_AGENT_ID=cursor
# OPENCLAW_LIGHT_AGENT_ID=main
#
# --- 调研 workflow（澄清 + 可选双 agent）---
# 首轮调研是否强制先澄清（默认 1）；用户下一条消息视为澄清回答后再进入正式调研
# FEISHU_RESEARCH_CLARIFY_FIRST=1
# 调研 V2：澄清完成后串行「资料收集 agent → 深度分析 agent」（默认 0；需在网关配置对应 agent 与模型）
# FEISHU_RESEARCH_WORKFLOW_V2=0
# 未设置时 crawler 回退 OPENCLAW_LIGHT_AGENT_ID，analyst 回退 OPENCLAW_HEAVY_AGENT_ID（示例：kimi 爬取 + gemini 分析）
# OPENCLAW_RESEARCH_CRAWLER_AGENT_ID=research-crawler
# OPENCLAW_RESEARCH_ANALYST_AGENT_ID=research-analyst
# 资料收集 / 分析阶段超时（秒，可选；未设时 crawler 取 min(600, CURSOR_ADHOC_TIMEOUT_SEC)，analyst 取 CURSOR_ADHOC_TIMEOUT_SEC）
# FEISHU_RESEARCH_CRAWLER_TIMEOUT_SEC=300
# FEISHU_RESEARCH_ANALYST_TIMEOUT_SEC=600
# 分析输出未通过结构校验时是否自动修复一轮（默认 1）
# FEISHU_RESEARCH_QUALITY_REPAIR=1
# 澄清等待状态持久化文件（可选；默认 var/state/feishu-research-workflow.json）
# FEISHU_RESEARCH_WORKFLOW_STATE_FILE=/opt/feishu-bridge/var/state/feishu-research-workflow.json
#
# 可选：飞书桥在 OpenClaw 网关上的会话命名空间（同一网关多入口时防串台；仅 [A-Za-z0-9_-]，空则保持旧 key 形态）
# OPENCLAW_FEISHU_SESSION_NAMESPACE=feishu-bridge-prod
#
# 飞书应用凭证与 secret 需按部署环境单独注入，不应提交到仓库。
#
# =========================
# 部署路径 / 运行时增强
# =========================
# --- 回复形态（默认交互卡片）---
# interactive：优先发飞书消息卡片（note/hr/markdown 表格等），失败则降级为 post 富文本，再失败为纯 text
# post：仅 post 富文本 + text
# text：仅纯文本
# FEISHU_REPLY_MESSAGE_FORMAT=interactive
# systemd 若 WorkingDirectory=/opt/feishu-bridge，则下面两个应指向同一部署根。
FEISHU_BRIDGE_ROOT=/opt/feishu-bridge
FEISHU_BRIDGE_REPO=/opt/feishu-bridge

# 渠道运行模式（方案 B 迁移用）
# legacy-bridge：默认，当前独立 bridge 主链路
# plugin-native：插件化准备态，用于灰度与切流验证
# FEISHU_CHANNEL_RUNTIME_MODE=legacy-bridge
#
# 群聊是否必须 @bot 才触发（默认 1）
# FEISHU_CURSOR_GROUP_REQUIRE_AT_BOT=1
#
# 工作流识别提示（默认 1）：在正式执行前先回一条短消息，例如 `已识别：research / clarify`
# FEISHU_WORKFLOW_TRACE_HINT=1
#
# OpenClaw 超时时间（秒）
# CURSOR_ADHOC_TIMEOUT_SEC=600
#
# 回复底部一行用量（编排模型·token·执行模型·token；有数据时 token 默认按「万」如 155.5万）
# FEISHU_REPLY_USAGE_FOOTER=1
# =1：仍解析不到用量/模型时不追加脚注；未设置时无数据会追加占位行
# FEISHU_REPLY_USAGE_SKIP_WHEN_EMPTY=1
# token 缩写单位：未设或 `wan` = 万（÷10000）；`k` = 千（÷1000，旧版）
# FEISHU_REPLY_USAGE_TOKENS_UNIT=k
# token 用原始整数（不缩写）
# FEISHU_REPLY_USAGE_TOKENS_RAW=1
# 占位符（默认 Unicode 长横线 —）
# FEISHU_REPLY_USAGE_PLACEHOLDER=—
# 模型名最大展示长度（默认 36）
# FEISHU_REPLY_USAGE_MODEL_MAX=36
#
# 当网关 history 里编排与执行被标成同一 model（如两个豆包）时，右侧「执行」模型名用本变量；不设则回退 CURSOR_AGENT_FULL_MODEL
# FEISHU_REPLY_USAGE_EXECUTOR_MODEL=composer-2

# =========================
# 可选增强块：云文档导出
# =========================
# --- 云文档导出（调研 / 报告，可选）---
# 主开关（二选一，任一为 1 即开启；未设置则不会创建云文档）：
# FEISHU_CLOUD_DOC_EXPORT=1
# FEISHU_RESEARCH_DOC_EXPORT=1
#
# 排障：在 systemd 环境打导出决策日志
# FEISHU_DOC_EXPORT_DEBUG=1
#
# 创建失败时在回复顶部提示（默认开启；设为 0 关闭）
# FEISHU_DOC_EXPORT_SHOW_ERRORS=1
#
# 群消息最大长度（默认 120000，避免云文档链接被截断）
# FEISHU_IM_REPLY_MAX_CHARS=120000
#
# 命中哪些任务类型（逗号分隔，默认 research,report）：
# FEISHU_DOC_EXPORT_MODES=research,report
#
# 长回复自动落云文档（不限 taskType）：正文长度 ≥ N 且 runner 成功时，按「报告」路径导出（需 MODES 含 report、且 FEISHU_CLOUD_DOC_EXPORT=1）。
# 设为 0 或不设则关闭。建议生产 3000–8000。
# FEISHU_DOC_EXPORT_LONG_REPLY_MIN_CHARS=3000
#
# 仅当非空时：仅列出的 chat_id 允许长回复自动导出（逗号分隔）；不设表示所有会话均可。
# FEISHU_DOC_EXPORT_LONG_REPLY_CHAT_IDS=oc_xxx,oc_yyy
#
# 应用须具备「创建/编辑新版文档」及写入块等 docx 权限；建议配置应用自建文件夹 token：
# FEISHU_DOCS_EXPORT_FOLDER_TOKEN=
#
# 文档/表格创建后自动授予管理权（full_access）：
# - 优先使用 open_id（逗号分隔）
# FEISHU_DOC_ADMIN_OPEN_IDS=ou_xxx,ou_yyy
# - 或使用邮箱（会自动解析为 open_id 后授权）
# FEISHU_DOC_ADMIN_EMAILS=you@example.com
# 兼容别名（可二选一）：
# FEISHU_DOC_OWNER_OPEN_IDS=ou_xxx
# FEISHU_DOC_OWNER_EMAILS=you@example.com
#
# 可选：把指定群聊加为协作者（open_chat_id，需机器人已在群内；tenant 调用见开放平台「添加协作者」说明）
# FEISHU_DOC_EXPORT_GRANT_CHAT_ID=oc_xxx
#
# 云文档**全部写入成功**后，飞书聊天是否只发「标题概要 + 云文档链接」（默认 1；设为 0 则聊天里仍贴全文 + 链接）
# FEISHU_DOC_EXPORT_CHAT_SUMMARY_ONLY=1
#
# 同步正文最大字符（默认 120000）
# FEISHU_DOCS_EXPORT_MAX_CHARS=120000
#
# 单次文档最多写入的块数量（防止超大 Markdown 打爆 API，默认 600）
# FEISHU_DOC_EXPORT_MAX_BLOCKS=600
#
# 文档标题前缀；不设时调研用 [调研]、报告用 [报告]
# FEISHU_DOCS_EXPORT_TITLE_PREFIX=
#
# 云文档链接域名（强烈建议必填）：浏览器打开云文档时地址栏的「主域名」。
# 未配置时默认 https://feishu.cn ，多数企业租户下会 **打不开/提示文档不存在**。
# 示例（按你司飞书实际域名填写）：
# FEISHU_DOC_PORTAL_ORIGIN=https://abc.feishu.cn
#
# 写入后校验正文最小字符（raw_content），低于此值视为导出失败并不发链接（默认 60）
# FEISHU_DOC_EXPORT_VERIFY_MIN_CHARS=60
#
# 仅纯文本分块写入（不解析 Markdown 结构），调试用：
# FEISHU_DOC_EXPORT_PLAIN_ONLY=0
#
# 调研文档增强：自动抓取竞品公开页面截图并插入飞书原生图片块（默认 1）
# FEISHU_DOC_EXPORT_SCREENSHOTS=1
# 截图服务地址
# FEISHU_DOC_EXPORT_SCREENSHOT_SERVER=http://127.0.0.1:17654
# 单篇文档最多插入几张截图（默认 3）
# FEISHU_DOC_EXPORT_SCREENSHOT_MAX_IMAGES=3
# 截图服务单次请求超时（毫秒，默认 45000）
# FEISHU_DOC_EXPORT_SCREENSHOT_CAPTURE_TIMEOUT_MS=45000

# 创建失败时是否在回复末尾追加说明（默认 0）
# FEISHU_RESEARCH_DOC_EXPORT_APPEND_FAILURE=0
#
# --- 云文档 / 电子表格「写入身份」（可选）---
# 默认使用 tenant_access_token，新建文件在应用（机器人「小智」）名下，不一定出现在你的个人会话/云空间默认列表。
# 若希望脚本创建的文件归到你个人名下，需使用用户 OAuth 的 user_access_token：
#
# 1) 在飞书开放平台为应用开通「用户身份」相关 OAuth，并完成一次授权拿到 refresh_token；
# 2) 将 token JSON 存到仅 root 可读的文件（格式与白板 FEISHU_WHITEBOARD_TOKEN_STORE 相同，含 access_token / refresh_token / expires 等）；
# 3) 配置下面路径后，`export-md-to-feishu-docx.js` 与 `create-feishu-workflow-master-workbook.js` 会优先用用户 token 创建。
#
# FEISHU_DRIVE_USER_TOKEN_STORE=/etc/feishu-drive-user.token.json
# 可选：显式要求走用户 token（未配 STORE 时会报错并回退 tenant）
# FEISHU_DRIVE_USE_USER_TOKEN=1
# 可选：仅调试时临时填入短期 user access_token（不推荐生产）
# FEISHU_DRIVE_USER_ACCESS_TOKEN=

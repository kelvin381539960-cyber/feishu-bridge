                <mxCell id="aai" value="&lt;b&gt;AAI&lt;/b&gt;&lt;br&gt;身份核验服务商" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6B46C1;strokeColor=#4A2B8C;fontColor=#ffffff;arcSize=10;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="840" y="420" width="160" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="e1" value="① 发起开户申请" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;fontSize=12;" parent="1" source="customer" target="app" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e2" value="② 提交开户审核请求" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;fontSize=12;" parent="1" source="app" target="aix" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e3" value="③ 请求身份核验服务" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;fontSize=12;exitX=0.75;exitY=0;entryX=0;entryY=0.5;" parent="1" source="aix" target="kun" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="640" y="190"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e4" value="④ 通过 SDK/H5 直接上传&lt;br&gt;证件、人脸、地址证明&lt;br&gt;（敏感数据不经 AIX）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;fontSize=12;exitX=0.5;exitY=1;entryX=0;entryY=0.5;dashed=1;" parent="1" source="app" target="aai" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="300" y="450"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e5" value="⑤ 返回采集结果" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;fontSize=12;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" parent="1" source="aai" target="kun" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e6" value="⑥ 通知审核结果（通过/拒绝）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;fontSize=12;exitX=0;exitY=0.75;entryX=1;entryY=0.25;" parent="1" source="kun" target="aix" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="760" y="205"/>
                            <mxPoint x="760" y="300"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e7" value="⑦ 开通账户功能" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;fontSize=12;exitX=0.25;exitY=0;entryX=0.5;entryY=0;" parent="1" source="aix" target="aix" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="560" y="230"/>
                            <mxPoint x="600" y="230"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e8" value="⑧ 通知开户结果&lt;br&gt;（通过 / 拒绝 ）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;fontSize=12;exitX=0.25;exitY=1;entryX=0.75;entryY=1;" parent="1" source="aix" target="app" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="560" y="410"/>
                            <mxPoint x="330" y="410"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="footnote" value="&lt;b&gt;图注：&lt;/b&gt;AIX 不存储用户证件原件，由专业第三方（AAI）独立核验后仅返回结论。KUN 作为持牌合规网关统一编排 KYC 流程。&lt;br&gt;这种多方协作降低了 AIX 的数据泄露风险和合规存储压力，同时满足监管对身份核验独立性的要求。&lt;br&gt;&lt;i&gt;虚线箭头（④）表示敏感数据直传路径，不经过 AIX 系统。&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="60" y="520" width="700" height="70" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>

    <diagram id="flow-1" name="Account Opening &amp; KYC">
        <mxGraphModel dx="721" dy="271" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="800" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="&lt;b style=&quot;font-size: 20px;&quot;&gt;Flow 1: Account Opening &amp;amp; KYC（开户与身份认证）&lt;/b&gt;&lt;br&gt;&lt;i&gt;业务交互结构图 · v0.2&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="60" y="40" width="550" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="customer" value="&lt;b&gt;Customer&lt;/b&gt;&lt;br&gt;用户" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#4D4D4D;strokeColor=#333333;fontColor=#ffffff;verticalAlign=bottom;" parent="1" vertex="1">
                    <mxGeometry x="60" y="280" width="60" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="app" value="&lt;b&gt;AIX App&lt;/b&gt;&lt;br&gt;用户端应用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2D78C8;strokeColor=#1A5296;fontColor=#ffffff;arcSize=10;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="240" y="290" width="120" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="aix" value="&lt;b&gt;AIX Platform&lt;/b&gt;&lt;br&gt;核心账本与风控系统" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1459c7;strokeColor=#0d4cae;fontColor=#ffffff;arcSize=10;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="520" y="280" width="160" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="kun" value="&lt;b&gt;KUN&lt;/b&gt;&lt;br&gt;卡发行与合规网关" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#238B68;strokeColor=#155D45;fontColor=#ffffff;arcSize=10;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="840" y="160" width="160" height="60" as="geometry"/>
